# Copy to .env (local) or keep as the server env file. Placeholders only: never commit real values.
# Variable meanings: docs/KEYS.md

# Server
# Port the API listens on when you run it without Docker (local default 4211).
# The Docker deploy scripts and compose files set their own PORT, which wins over this line.
PORT=4211
# production makes the accessToken cookie secure (set by deploy_prod.sh)
NODE_ENV=development

# MongoDB connection string
MONGO_URL=mongodb://localhost:27017/wearit

# Admin session cookie
SESSION_SECRET=change-me
# true = admin session cookie is HTTPS-only
COOKIE_SECURE=false

# JWT signing secret (rotating it logs every storefront user out)
SECRET_TOKEN=change-me

# Supabase Storage (images). Server-side secret key, not the anon key.
SUPABASE_PROJECT_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=change-me
